{
	"name": "unique-id-generator",
	"version": "0.1.0",
	"description": "Generate short unique IDs for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"license": "MIT",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"test": "bun test",
		"check": "tsc -noEmit -p test && tsc -noEmit -p tsconfig.tools.json && biome check . && eslint .",
		"fix": "biome check --write . && eslint --fix .",
		"bump": "bun scripts/version-bump.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/bun": "latest",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"nanoid": "6.0.2",
		"sqids": "0.3.0",
		"ulid": "3.0.2",
		"uuid": "14.0.3"
	}
}
